# Accentra Fraud Engine Environment Configuration

# Database: SQLite for local dev, PostgreSQL for production/docker
DATABASE_URL=sqlite:///./fraud_engine.db
# DATABASE_URL=postgresql://fraud_user:fraud_password@localhost:5432/fraud_engine

# Risk Scoring Thresholds
FLAG_THRESHOLD=50       # Score >= 50 triggers PENDING FraudFlag
HIGH_RISK_THRESHOLD=80  # Score >= 80 dispatches SNS/SES alert

# Alert Dispatcher: log (local dev) | sns (AWS SNS) | ses (AWS SES)
NOTIFIER=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fraud-alerts
SES_SENDER=alerts@fraud-engine.internal
SES_RECIPIENTS=["security-ops@fraud-engine.internal"]

# Reviewer Console URL (used in alert links)
CONSOLE_URL=http://localhost:5173
